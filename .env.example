# ZENITH Environment Configuration
# Copy this file to .env and fill in your credentials

# MySQL Database (auto-configured by docker-compose)
DATABASE_URL=mysql://zenith:zenith_pass@mysql:3306/zenith

# Kimi Platform Credentials (optional, for OAuth login)
APP_ID=your_app_id
APP_SECRET=your_app_secret
KIMI_AUTH_URL=https://kimi.com
KIMI_OPEN_URL=https://kimi.com
OWNER_UNION_ID=your_union_id

# Moonshot AI API Key (for translation)
MOONSHOT_API_KEY=your_moonshot_key

# Application URL
APP_URL=http://localhost:3000
